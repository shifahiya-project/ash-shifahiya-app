{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build:static": "STATIC_BASE=./ npm run build && node scripts/build-static.mjs",
    "test": "npm run build && node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "content:manifest": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-manifest.mjs",
    "part2:import": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/import-part2.mjs",
    "part3:import": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/import-part3.mjs",
    "part4:import": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/import-part4.mjs",
    "podcasts:import": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/import-podcasts.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .static-site",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright-core": "1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
